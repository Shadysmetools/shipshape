{
 "name": "Notepad: type, read back, Save As cancelled, close the test tab without saving",
 "steps": [
  {"do": "launch", "app": "Notepad", "require_new": true, "shot": false, "say": "Open a new Notepad window from the Start menu."},
  {"do": "mask", "above_control": {"role": "Document", "name": "Text editor"}, "say": "Hide the tab names for privacy."},
  {"do": "key", "keys": ["ctrl", "n"], "shot": false},
  {"do": "wait", "sec": 1},
  {"do": "record_start"},
  {"do": "type", "control": {"role": "Document", "name": "Text editor"}, "text": "ShipShape device-control test (fake data, never saved).", "say": "Type a test sentence into a new tab."},
  {"do": "read", "control": {"role": "Document", "name": "Text editor"}, "save_as": "typed"},
  {"do": "assert_text", "case": "NP-01", "name": "read-back", "control": {"role": "Document", "name": "Text editor"}, "equals": "ShipShape device-control test (fake data, never saved).", "stop_on_fail": true, "say": "Read the text back through UI Automation and compare it."},
  {"do": "mask", "rect": [0, 0, 1, 1], "replace": true, "allow_large": true, "say": "Hide the window before Save As opens: it lists folders."},
  {"do": "key", "keys": ["ctrl", "shift", "s"], "shot": false, "say": "Open Save As."},
  {"do": "assert_control", "case": "NP-02", "name": "save-as-open", "control": {"role": "Window", "name": "Save as"}, "stop_on_fail": true, "shot": false},
  {"do": "mask", "replace": true, "refocus": false, "allow_large": true, "regions": [{"above_control": {"role": "Document", "name": "Text editor"}}, {"within": {"role": "Window", "name": "Save as"}, "rect": [0, 0, 1, 0.8]}]},
  {"do": "screenshot", "case": "NP-02b", "name": "save-as-buttons"},
  {"do": "click", "control": {"role": "Button", "name": "Cancel", "in": {"role": "Window", "name": "Save as"}}, "shot": false, "say": "Cancel it: nothing is saved."},
  {"do": "assert_control", "case": "NP-03", "name": "save-as-cancelled", "control": {"role": "Window", "name": "Save as"}, "present": false, "shot": false},
  {"do": "mask", "replace": true, "regions": [{"above_control": {"role": "Document", "name": "Text editor"}}]},
  {"do": "mask", "control": {"role": "Document", "name": "Text editor"}, "allow_large": true, "say": "Hide the editor before the tab closes, so no other note shows."},
  {"do": "key", "keys": ["ctrl", "w"], "shot": false, "say": "Close the test tab."},
  {"do": "assert_control", "case": "NP-04", "name": "save-prompt-is-for-test-tab", "control": {"role": "Text", "name_re": "^Do you want to save changes to ShipShape device-control test"}, "stop_on_fail": true},
  {"do": "click", "control": {"role": "Button", "name": "Don't save", "in": {"role": "Window", "name_re": "^Notepad$"}}, "confirmed": true, "shot": false, "say": "Choose Don't save."},
  {"do": "assert_control", "case": "NP-05", "name": "closed-without-saving", "control": {"role": "Text", "name_re": "^Do you want to save changes to ShipShape device-control test"}, "present": false},
  {"do": "close", "only_if_launched": true, "say": "Close the Notepad window this test opened."},
  {"do": "assert_window", "case": "NP-06", "name": "no-test-window-left", "window": "Untitled - Notepad", "present": false}
 ],
 "cleanup": [
  {"do": "mask", "control": {"role": "Document", "name": "Text editor"}, "allow_large": true},
  {"do": "assert_control", "name": "test-tab-still-open", "control": {"role": "TabItem", "name_re": "^ShipShape device-contr"}, "stop_on_fail": true, "timeout": 3},
  {"do": "click", "control": {"role": "TabItem", "name_re": "^ShipShape device-contr"}, "shot": false},
  {"do": "key", "keys": ["ctrl", "w"], "shot": false},
  {"do": "assert_control", "name": "prompt-is-for-test-tab", "control": {"role": "Text", "name_re": "^Do you want to save changes to ShipShape device-contr"}, "stop_on_fail": true},
  {"do": "click", "control": {"role": "Button", "name": "Don't save", "in": {"role": "Window", "name_re": "^Notepad$"}}, "confirmed": true, "shot": false},
  {"do": "close", "only_if_launched": true}
 ]
}
